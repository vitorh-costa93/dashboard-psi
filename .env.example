# Server-side Supabase access used by the Vercel API routes.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
CLINICAL_DATA_KEY=
PUBLIC_FORM_ORIGIN=https://consultorio-jaqueline.vercel.app

# Server-side OpenAI access.
OPENAI_KEY=
# Modelos vêm de lib/ai-models.js (texto gpt-6-luna, imagem gpt-image-2.5-flare medium).
# Override opcional por tarefa: AI_MODEL_<TAREFA>=...  Teto mensal (só avisa): AI_MONTHLY_CAP_USD=5

# Shared secret used by Vercel Cron to call /api/trends.
CRON_SECRET=
